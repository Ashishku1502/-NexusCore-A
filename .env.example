# ─────────────────────────────────────────────
#  NexusCore — Environment Configuration
#  Copy this file to .env for local development
# ─────────────────────────────────────────────

# ── Required ──────────────────────────────────
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Optional: Pinecone Vector Memory ──────────
# Leave blank to use in-memory mock fallback
PINECONE_API_KEY=
PINECONE_INDEX_NAME=nexuscore-memory

# ── Server Settings ───────────────────────────
PORT=3001

# CLIENT_URL: Allowed frontend origin(s)
# Comma-separate multiple URLs if needed
# Local:      CLIENT_URL=http://localhost:5173
# Production: CLIENT_URL=https://your-app.netlify.app
# Both:       CLIENT_URL=https://your-app.netlify.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# ── Frontend → Backend Connection ─────────────
# Set this in Netlify environment variables dashboard
# Local:      VITE_SERVER_URL=http://localhost:3001
# Production: VITE_SERVER_URL=https://your-railway-app.up.railway.app
VITE_SERVER_URL=http://localhost:3001

# ── Demo Mode ─────────────────────────────────
# Set to true to run without a real Anthropic API key (simulated responses)
MOCK_MODE=false
