# NexusCore Configuration

# Required: Anthropic API Key for Claude models
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Pinecone for vector memory (mock fallback if missing)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=nexuscore-memory

# Server Settings
PORT=3001
# CLIENT_URL: Your frontend URL (local dev or Netlify production URL)
# Local:      CLIENT_URL=http://localhost:5173
# Production: CLIENT_URL=https://your-app.netlify.app
CLIENT_URL=http://localhost:5173

# Frontend → Backend connection (set this in Netlify environment variables)
# Local:      VITE_SERVER_URL=http://localhost:3001
# Production: VITE_SERVER_URL=https://your-railway-app.up.railway.app
VITE_SERVER_URL=http://localhost:3001
